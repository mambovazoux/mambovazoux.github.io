<!DOCTYPE html>
<html lang="pt-AO">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mambo Vazoux - Moda Angolana</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#f5f5f5}
.header{background:#000;color:#fff;padding:15px;text-align:center}
.ad-slot{background:#e0e0e0;border:2px dashed #999;display:flex;align-items:center;justify-content:center;color:#555;font-weight:bold;margin:15px auto;text-align:center}
.ad-top{width:100%;max-width:728px;height:90px}
.ad-middle{width:100%;max-width:728px;height:250px}
.ad-sidebar{width:300px;height:600px}
.ad-footer{width:100%;max-width:970px;height:90px}
.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:15px;padding:15px}
.card{background:#fff;border-radius:10px;padding:10px;box-shadow:0 2px 5px rgba(0,0,0,.1)}
.card img{width:100%;height:180px;object-fit:cover;border-radius:8px}
.btn{background:#000;color:#fff;padding:10px;width:100%;border:none;border-radius:6px;margin-top:8px}
.layout{display:flex;gap:15px;max-width:1200px;margin:0 auto}
.main{flex:1}
@media(max-width:800px){.layout{flex-direction:column}.ad-sidebar{width:100%;height:250px}}
</style>
</head>
<body>

<div class="header">
<h1>MAMBO VAZOUX</h1>
<p>Moda que é nossa</p>
</div>

<!-- ADS TOPO - Cole aqui seu código do AdSense -->
<div class="ad-slot ad-top" id="ad-top">
  ESPAÇO ANÚNCIO TOPO 728x90
  <!-- COLE AQUI: <script async src="adsense..."></script> -->
</div>

<div class="layout">
<div class="main">
<div class="products" id="products">Carregando produtos...</div>

<!-- ADS NO MEIO DOS PRODUTOS -->
<div class="ad-slot ad-middle" id="ad-middle">
  ESPAÇO ANÚNCIO MEIO 728x250
  <!-- COLE AQUI SEU CÓDIGO ADS -->
</div>

<div class="products" id="products2"></div>
</div>

<!-- ADS LATERAL STICKY -->
<div class="ad-slot ad-sidebar" id="ad-sidebar">
  ESPAÇO ANÚNCIO LATERAL 300x600
  <!-- COLE AQUI SEU CÓDIGO ADS -->
</div>
</div>

<!-- ADS FOOTER -->
<div class="ad-slot ad-footer">
  ESPAÇO ANÚNCIO RODAPÉ 970x90
</div>

<script>
const SUPABASE_URL = "SUA_URL_AQUI";
const SUPABASE_KEY = "SUA_KEY_AQUI";
const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

async function loadProducts(){
  const {data} = await supabaseClient.from('produtos').select('*').order('created_at',{ascending:false});
  const container = document.getElementById('products');
  if(!data || data.length==0){container.innerHTML="Sem produtos ainda";return}
  container.innerHTML = data.map(p=>`
    <div class="card">
      <img src="${p.imagem_url || 'https://via.placeholder.com/200'}">
      <h3>${p.nome}</h3>
      <p>${p.preco} Kz</p>
      <button class="btn" onclick="alert('Comprar ${p.nome}')">Comprar</button>
    </div>
  `).join('');
}
loadProducts();
</script>
</body>
</html>
